# Telegram bot token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# TMDB "API Read Access Token" from https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# Any OpenAI-compatible server. Defaults to a local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama
# "compact" only when LLM_MODEL is the Reel fine-tune (see training/README.md)
LLM_PROMPT=full

# Where the local database lives
DATABASE_PATH=data/pglite

# Optional: TabPFN via the Prior Labs API (https://ux.priorlabs.ai → API keys).
# Without it, suggestions use a local ridge regression.
PRIORLABS_API_KEY=
TABPFN_MODEL_PATH=v3.5_default

# Optional: voice notes via whisper.cpp (brew install whisper-cpp) and ffmpeg.
# Model: curl -L -o data/models/ggml-base.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin
WHISPER_MODEL_PATH=
WHISPER_CLI=whisper-cli
WHISPER_LANGUAGE=auto
